<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Metropolitan Mobility Infrastructure Portfolio</title>
<meta name="description" content="Infrastructure portfolio — Metropolitan mobility corridors, strategic nodes and platform capabilities. Informational purposes only." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0B0F19;
    --bg-2: #0F1524;
    --card: #FFFFFF10;
    --card-border: #FFFFFF1A;
    --text: #F5F7FA;
    --muted: #9AA4B2;
    --ausol: #F28C28;
    --gpaz: #6BBB5E;
    --gco: #3498DB;
    --total: #E5E7EB;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ============ NAV ============ */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 20px 0;
    background: rgba(11, 15, 25, 0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--card-border);
  }
  nav .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 15px;
  }
  .brand-dots { display: flex; gap: 4px; }
  .brand-dots span {
    width: 8px; height: 8px; border-radius: 50%;
  }
  .brand-dots span:nth-child(1) { background: var(--ausol); }
  .brand-dots span:nth-child(2) { background: var(--gpaz); }
  .brand-dots span:nth-child(3) { background: var(--gco); }
  .nav-links {
    display: flex; gap: 28px;
    font-size: 13px;
    color: var(--muted);
    font-weight: 500;
  }
  .nav-links a {
    color: inherit; text-decoration: none;
    transition: color .2s;
  }
  .nav-links a:hover { color: var(--text); }

  /* ============ HERO ============ */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, rgba(52,152,219,0.18), transparent 70%),
      radial-gradient(ellipse 60% 50% at 20% 70%, rgba(242,140,40,0.10), transparent 70%),
      radial-gradient(ellipse 60% 50% at 85% 30%, rgba(107,187,94,0.10), transparent 70%),
      var(--bg);
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 50% 50%, black 40%, transparent 100%);
    z-index: 1;
  }
  .hero-corridors {
    position: absolute; inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-corridors svg {
    width: 100%; height: 100%;
    opacity: 0.5;
  }

  .hero .container { position: relative; z-index: 2; }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 28px;
    padding: 8px 14px;
    border: 1px solid var(--card-border);
    border-radius: 100px;
    background: rgba(255,255,255,0.03);
  }
  .eyebrow .pulse {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--gpaz);
    box-shadow: 0 0 0 0 rgba(107,187,94,0.6);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(107,187,94,0.6); }
    70% { box-shadow: 0 0 0 10px rgba(107,187,94,0); }
    100% { box-shadow: 0 0 0 0 rgba(107,187,94,0); }
  }

  h1 {
    font-size: clamp(40px, 6vw, 76px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin-bottom: 28px;
    max-width: 14ch;
  }
  h1 .accent {
    background: linear-gradient(90deg, var(--ausol), var(--gpaz), var(--gco));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--muted);
    max-width: 56ch;
    font-weight: 400;
    margin-bottom: 64px;
  }

  /* KPI row */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--card-border);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    overflow: hidden;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .kpi {
    background: rgba(11,15,25,0.55);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .kpi-value {
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .kpi-label {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  /* ============ SECTIONS ============ */
  section {
    padding: 120px 0;
    position: relative;
  }
  .section-head {
    margin-bottom: 56px;
    max-width: 720px;
  }
  .section-tag {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .section-tag::before {
    content: "";
    width: 24px; height: 1px;
    background: var(--muted);
  }
  h2 {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .section-desc {
    font-size: 16px;
    color: var(--muted);
    max-width: 60ch;
  }

  /* ============ MAP SECTION ============ */
.map-wrap {
  position: relative;
  border: 1px solid var(--card-border);
  border-radius: 20px;
  overflow: hidden;
  background: var(--bg-2);
  aspect-ratio: 16 / 9;
  min-height: 480px;
}
.map-wrap iframe {
  width: 100%; height: 100%;
  border: 0;
  display: block;
  filter: invert(0.92) hue-rotate(180deg) saturate(0.7) brightness(0.9);
  /* Bloqueado por defecto: el scroll pasa de largo */
  pointer-events: none;
  transition: filter .3s;
}
/* Cuando está activo, el iframe recibe eventos */
.map-wrap.is-active iframe {
  pointer-events: auto;
  filter: invert(0.92) hue-rotate(180deg) saturate(0.7) brightness(0.9);
}

/* Overlay de activación */
.map-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(11, 15, 25, 0.35);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
  cursor: pointer;
  transition: opacity .3s, visibility .3s;
}
.map-wrap.is-active .map-overlay {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.map-overlay-inner {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 22px;
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  background: rgba(11, 15, 25, 0.85);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 100px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.4);
}
.map-overlay-inner svg {
  width: 16px; height: 16px;
  opacity: 0.9;
}

/* Botón "liberar scroll" — solo visible cuando el mapa está activo */
.map-release {
  position: absolute;
  top: 16px; right: 16px;
  z-index: 4;
  display: none;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  background: rgba(11, 15, 25, 0.85);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 8px;
  cursor: pointer;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  transition: background .2s, border-color .2s;
}
.map-wrap.is-active .map-release {
  display: inline-flex;
}
.map-release:hover {
  background: rgba(11, 15, 25, 0.95);
  border-color: rgba(255,255,255,0.3);
}
.map-release svg {
  width: 14px; height: 14px;
}

.map-note {
  position: absolute;
  bottom: 16px; left: 16px;
  z-index: 2;
  font-size: 12px;
  color: var(--muted);
  background: rgba(11,15,25,0.8);
  padding: 8px 14px;
  border-radius: 8px;
  border: 1px solid var(--card-border);
  backdrop-filter: blur(8px);
}

  /* ============ CORRIDOR CARDS ============ */
  .cards-4 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 28px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: transform .3s, border-color .3s, background .3s;
    position: relative;
    overflow: hidden;
  }
  .card::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent, transparent);
    opacity: 0.8;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.2);
    background: rgba(255,255,255,0.06);
  }
  .card-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .card-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--accent, var(--muted));
    box-shadow: 0 0 12px var(--accent, transparent);
  }
  .card-value {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .card-label {
    font-size: 12px;
    color: var(--muted);
  }
  .card-sub {
    font-size: 12px;
    color: var(--muted);
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--card-border);
    line-height: 1.5;
    opacity: 0.85;
  }

  /* Network total banner */
  .network-total {
    margin-top: 32px;
    padding: 40px;
    border: 1px solid var(--card-border);
    border-radius: 20px;
    background:
      radial-gradient(ellipse 60% 100% at 50% 0%, rgba(52,152,219,0.12), transparent 70%),
      var(--card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .network-total::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--ausol), var(--gpaz), var(--gco), transparent);
    opacity: 0.6;
  }
  .network-total-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    font-weight: 600;
    margin-bottom: 12px;
  }
  .network-total-value {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(90deg, var(--ausol), var(--gpaz), var(--gco));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 12px;
  }
  .network-total-sub {
    font-size: 14px;
    color: var(--muted);
  }

  /* ============ NODES ============ */
  .nodes-subhead {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nodes-subhead::before {
    content: "";
    width: 24px; height: 1px;
    background: var(--muted);
  }

  /* Metropolitan nodes grid (ahora 5 cards) */
  .nodes-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
    margin-bottom: 56px;
  }
  .node {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 28px;
    transition: transform .3s, border-color .3s;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .node:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.2);
  }
  .node-icon {
    width: 40px; height: 40px;
    border-radius: 10px;
    background: rgba(52,152,219,0.15);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: 20px;
    font-size: 18px;
  }
  .node-name {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .node-value {
    font-size: 14px;
    color: var(--muted);
  }
  .node-value strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Grouped nodes by corridor (ahora solo General Paz) */
  .nodes-groups {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .node-group {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 28px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    position: relative;
    overflow: hidden;
  }
  .node-group::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent, transparent);
    opacity: 0.85;
  }
  .node-group-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--card-border);
  }
  .node-group-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
  }
  .node-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .node-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }
  .node-item:last-child { border-bottom: 0; }
  .node-item-name {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .node-item-value {
    font-size: 14px;
    color: var(--muted);
    white-space: nowrap;
  }
  .node-item-value strong {
    color: var(--text);
    font-weight: 700;
    font-size: 15px;
  }

  /* ============ CAPABILITIES ============ */
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .cap {
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 36px;
    display: flex;
    gap: 24px;
    align-items: flex-start;
    transition: transform .3s, border-color .3s;
  }
  .cap:hover {
    transform: translateY(-4px);
    border-color: rgba(255,255,255,0.2);
  }
  .cap-icon {
    font-size: 28px;
    width: 56px; height: 56px;
    border-radius: 14px;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--card-border);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .cap-title {
    font-size: 18px;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .cap-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }

  /* ============ PORTFOLIO BARS ============ */
  .bars {
    display: flex;
    flex-direction: column;
    gap: 28px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    padding: 40px;
  }
  .bar-row {
    display: grid;
    grid-template-columns: 140px 1fr 100px;
    align-items: center;
    gap: 24px;
  }
  .bar-name {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bar-track {
    height: 14px;
    background: rgba(255,255,255,0.05);
    border-radius: 100px;
    overflow: hidden;
    position: relative;
  }
  .bar-fill {
    height: 100%;
    border-radius: 100px;
    width: 0;
    transition: width 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .bar-fill.ausol { background: linear-gradient(90deg, rgba(242,140,40,0.5), var(--ausol)); width: 30%; }
  .bar-fill.gpaz  { background: linear-gradient(90deg, rgba(107,187,94,0.5), var(--gpaz)); width: 14%; }
  .bar-fill.gco   { background: linear-gradient(90deg, rgba(52,152,219,0.5), var(--gco)); width: 27%; }
  .bar-fill.otros { background: linear-gradient(90deg, rgba(229,231,235,0.3), rgba(229,231,235,0.7)); width: 20%; }
  .bar-value {
    font-size: 14px;
    font-weight: 600;
    text-align: right;
    color: var(--text);
  }

  /* ============ CONTACT ============ */
  .contact-block {
    margin-top: 32px;
  }
  .contact-title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 16px;
  }
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: transform .2s, border-color .2s, background .2s;
    white-space: nowrap;
  }
  .contact-btn:hover {
    transform: translateY(-2px);
    border-color: rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.08);
  }
  .contact-btn svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.85;
  }

  /* Botón flotante */
  .contact-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .contact-float .contact-btn {
    background: rgba(11,15,25,0.85);
    border-color: rgba(255,255,255,0.15);
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
    padding: 12px 14px;
  }

  /* ============ FOOTER ============ */
  footer {
    border-top: 1px solid var(--card-border);
    padding: 64px 0 48px;
    margin-top: 60px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .footer-brand {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer-text {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.8;
    max-width: 60ch;
  }
  .footer-text p + p { margin-top: 10px; }
  .footer-meta {
    font-size: 12px;
    color: var(--muted);
    opacity: 0.7;
    padding-top: 24px;
    border-top: 1px solid var(--card-border);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* ============ RESPONSIVE ============ */
  @media (max-width: 1024px) {
    .cards-4 { grid-template-columns: repeat(2, 1fr); }
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
    .nodes-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .container { padding: 0 20px; }
    nav .nav-links { display: none; }
    section { padding: 80px 0; }
