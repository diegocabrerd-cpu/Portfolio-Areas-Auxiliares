<script>
  // Reveal on scroll
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        e.target.querySelectorAll('.bar-fill').forEach(b => {
          if (b.dataset.width) b.style.width = b.dataset.width;
        });
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.reveal').forEach(el => io.observe(el));
// === Mapa: activar/desactivar interacción para no romper el scroll ===
(function () {
  const mapWrap = document.getElementById('network-map');
  if (!mapWrap) return;

  const overlay = mapWrap.querySelector('.map-overlay');
  const release = mapWrap.querySelector('.map-release');

  function activate() {
    mapWrap.classList.add('is-active');
  }
  function deactivate() {
    mapWrap.classList.remove('is-active');
  }

  overlay.addEventListener('click', activate);
  overlay.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      activate();
    }
  });

  release.addEventListener('click', (e) => {
    e.stopPropagation();
    deactivate();
  });

  // Opcional: al salir del mapa con Escape, se desactiva
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mapWrap.classList.contains('is-active')) {
      deactivate();
    }
  });
})();
</script>

